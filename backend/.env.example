# HTTP bind address (optional, default: 0.0.0.0:3000)
LISTEN_ADDRESS="0.0.0.0:3000"

# Shippo API key — used to fetch shipment status.
SHIPPO_API_KEY="your_api_key_here"

# Oracle Ed25519 signing key (32 bytes, hex).
# The oracle signs OracleData CBOR bytes with this key; consumers embed the
# signature in the withdrawal redeemer.
# TODO: move to a secure vault 
ORACLE_SK="your_signing_key_hex_here"

# Oracle verification-key hash (blake2b-224 of vk, 28 bytes, hex).
ORACLE_PKH="your_public_key_hash_hex_here"

# Cardano address controlled by the oracle (holds the governance UTxO).
ORACLE_ADDRESS="addr_test1..."

# TRP endpoint used by consumers to resolve tx3 transactions.
TRP_URL="http://localhost:8164"

# Optional — required when the TRP endpoint enforces API keys (e.g. hosted).
# TRP_API_KEY="your_trp_api_key_here"
