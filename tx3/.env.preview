# --- parties --------------------------------------------------------------
# Oracle wallet (controls the seed UTxO, signs publish_scripts and
# bootstrap_governance, holds the governance NFT after bootstrap).
ORACLE="addr_test1vp2tvax0cdvrx7luzuu0gczzc7furzmmxckyfzshp97ruug0uxkj9"

# --- env block (matches `env { ... }` in main.tx3) ------------------------

# Compiled bytes of the governance_nft minting policy
# (plutus.json -> governance_nft.governance_nft.mint.compiledCode).
GOVERNANCE_NFT_SCRIPT=""

# Compiled bytes of the oracle withdrawal validator
# (plutus.json -> oracle.oracle.withdraw.compiledCode, second-pass build).
# Kept in env in case any tx needs to inline-witness it; `consume_oracle_data`
# attaches it via `oracle_script_ref` instead.
ORACLE_SCRIPT=""

# Reference UTxO carrying the oracle withdrawal validator as a reference
# script. Output of `publish_scripts` (#2 in dolos local). Used by
# `consume_oracle_data` to attach the script without inlining its bytes.
ORACLE_SCRIPT_REF="8e1777358328c2da42309379bf0a38baeb6312826c33b6ffc814175f32a63146#2"

# Reward (stake) address derived from the oracle withdrawal validator hash.
# Header byte 0xf0 = stake + script credential on testnet, followed by the
# 28-byte script hash (0b74fc50...), bech32-encoded with hrp "stake_test".
# Used by `cardano::withdrawal { from: oracle_script_hash, ... }`.
ORACLE_SCRIPT_HASH="stake_test17pkh9cnpfp25ruh8j0cejjmsvggc85x0q4d3w75qyuuq5dqughedk"

# Oracle Ed25519 verification key (32 bytes, hex). Stored inline in the
# governance UTxO datum and used on-chain by `verify_ed25519_signature`.
# Derived from local_wallets/oracle_wallet.vkey (cborHex without 5820 prefix).
ORACLE_VK="3790bbfe3a882cacede50bd81ef5a0203b006457246e47e977475478802540d6"

# Policy id of the governance NFT (== hash of governance_nft mint policy).
GOV_POLICY_ID="33f2b45c5911c2a66d93d8f60d07e34edee203d982d75637b09649ab"

# Asset name of the governance NFT (hex). 474f56 == ASCII "GOV".
GOV_ASSET_NAME="474f56"

# Seed UTxO consumed by the one-shot mint policy in `bootstrap_governance`.
# Must be controlled by the Oracle wallet and unspent at bootstrap time.
SEED_UTXO_REF="225d6c344ba5d2bccf57b1434e59bb5843dddbfd0d68285f1c805640eb7aec04#2"

# Governance UTxO: carries 1x b620cf9e...GOV + inline GovernanceDatum.
# Output of `bootstrap_governance`. Confirmed at index #0 in dolos local.
GOVERNANCE_UTXO_REF="3aa6f843e11db1a7f33f1b456ce6a61c7fee5bf82dd484ff26b5e52462fa4387#0"
