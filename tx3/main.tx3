party Oracle;
party Consumer;

env {
    governance_nft_script: Bytes,
    oracle_script: Bytes,
    oracle_script_hash: Address,
    oracle_script_ref: UtxoRef,
    oracle_vk: Bytes,
    gov_policy_id: Bytes,
    gov_asset_name: Bytes,
    seed_utxo_ref: UtxoRef,
    governance_utxo_ref: UtxoRef,
}

type GovernanceDatum {
    oracle_vk: Bytes,
}

type OracleData {
    carrier_hash: Bytes,
    tracking_number_hash: Bytes,
    status: Bytes,
    timestamp: Int,
}

type OracleRedeemer {
    data: OracleData,
    signature: Bytes,
}

// One-time: publishes governance_nft mint policy and oracle withdrawal
// validator as on-chain reference scripts. Consumers then attach them by
// reference, keeping their transactions small.
tx publish_scripts() {
    locals {
        deposit: 5000000,
    }

    input funds {
        from: Oracle,
        min_amount: fees + Ada(deposit) + Ada(deposit),
    }

    cardano::publish {
        to: Oracle,
        amount: Ada(deposit),
        version: 3,
        script: governance_nft_script,
    }

    cardano::publish {
        to: Oracle,
        amount: Ada(deposit),
        version: 3,
        script: oracle_script,
    }

    output change {
        to: Oracle,
        amount: funds - Ada(deposit) - Ada(deposit) - fees,
    }
}

// One-time: mints the governance NFT and locks it in a UTxO carrying the
// current oracle verification key. Consuming `seed_utxo_ref` enforces the
// one-shot minting policy so the NFT can never be minted again.
tx bootstrap_governance() {
    locals {
        gov_nft: AnyAsset(gov_policy_id, gov_asset_name, 1),
    }

    input seed {
        ref: seed_utxo_ref,
    }

    input funds {
        from: Oracle,
        min_amount: fees + min_utxo(governance),
    }

    mint {
        amount: gov_nft,
        redeemer: (),
    }

    cardano::plutus_witness {
        version: 3,
        script: governance_nft_script,
    }

    output governance {
        to: Oracle,
        amount: gov_nft + min_utxo(governance),
        datum: GovernanceDatum {
            oracle_vk: oracle_vk,
        },
    }

    output change {
        to: Oracle,
        amount: seed + funds - min_utxo(governance) - fees,
    }

    collateral {
        from: Oracle,
        min_amount: fees,
    }
}

// Demo consumer tx: retrieves signed OracleData from the backend, the
// on-chain oracle validator runs under the `withdraw` purpose and verifies
// the Ed25519 signature against the governance UTxO's inline datum.
tx consume_oracle_data(
    p_carrier_hash: Bytes,
    p_tracking_number_hash: Bytes,
    p_status: Bytes,
    p_timestamp: Int,
    p_signature: Bytes,
) {
    input funds {
        from: Consumer,
        min_amount: fees + min_utxo(attested) + min_utxo(change),
    }

    reference governance {
        ref: governance_utxo_ref,
    }

    reference oracle {
        ref: oracle_script_ref,
    }

    cardano::withdrawal {
        from: oracle_script_hash,
        amount: 0,
        redeemer: OracleRedeemer {
            data: OracleData {
                carrier_hash: p_carrier_hash,
                tracking_number_hash: p_tracking_number_hash,
                status: p_status,
                timestamp: p_timestamp,
            },
            signature: p_signature,
        },
    }

    output attested {
        to: Consumer,
        amount: min_utxo(attested),
        datum: OracleData {
            carrier_hash: p_carrier_hash,
            tracking_number_hash: p_tracking_number_hash,
            status: p_status,
            timestamp: p_timestamp,
        },
    }

    output change {
        to: Consumer,
        amount: funds - min_utxo(attested) - fees,
    }

    collateral {
        from: Consumer,
        min_amount: fees,
    }
}
